{
  "name": "mdvisualizer",
  "private": true,
  "version": "0.0.18+beta.1",
  "author": "KotorinChunChun",
  "license": "MIT",
  "repository": "https://github.com/KotorinChunChun/MdVisualizer",
  "type": "module",
  "workspaces": [
    "web-platform/packages/markdown-core"
  ],
  "scripts": {
    "build:embedded": "node scripts/build-embedded-tools.mjs",
    "predev": "npm run build:embedded",
    "prebuild": "npm run build:embedded",
    "prebuild:spfx:local": "npm run build:embedded",
    "prebuild:spfx": "npm run build:embedded",
    "build:web": "node scripts/build-web.mjs",
    "postbuild:web": "npm run test:button-layout-web",
    "dev": "vite",
    "run:debug": "pwsh -NoProfile -File ./scripts/run-debug-MdVisualizer-all.ps1",
    "run:release": "pwsh -NoProfile -File ./scripts/run-release-MdVisualizer-all.ps1",
    "run:exe": "pwsh -NoProfile -File ./scripts/run-exe-MdVisualizer-all.ps1",
    "debug:smoke": "pwsh -NoProfile -File ./scripts/run-debug-MdVisualizer-all-smoke.ps1",
    "build:core": "npm --workspace @mdvisualizer/markdown-core run build",
    "build": "npm run build:core && tsc && vite build",
    "build:spfx": "pwsh -NoProfile -File ./scripts/build-release-MdVisualizer-spfx.ps1",
    "build:spfx:local": "pwsh -NoProfile -File ./scripts/build-release-MdVisualizer-spfx.ps1",
    "package:msix": "pwsh -NoProfile -File ./scripts/package-MdVisualizer-msix.ps1",
    "package:appinstaller": "pwsh -NoProfile -File ./scripts/package-MdVisualizer-appinstaller.ps1",
    "build:msix": "npm run package:msix",
    "build:appinstaller": "npm run package:appinstaller",
    "release:plan": "pwsh -NoProfile -File ./scripts/plan-release-MdVisualizer.ps1",
    "release:build": "pwsh -NoProfile -File ./scripts/build-release-MdVisualizer.ps1",
    "release:stage": "pwsh -NoProfile -File ./scripts/stage-release-MdVisualizer.ps1",
    "release:publish": "pwsh -NoProfile -File ./scripts/publish-release-MdVisualizer.ps1",
    "release:verify": "pwsh -NoProfile -File ./scripts/verify-release-MdVisualizer.ps1",
    "release:full": "pwsh -NoProfile -File ./scripts/full-release-MdVisualizer.ps1",
    "release:stable": "pwsh -NoProfile -File ./scripts/full-release-stable-MdVisualizer.ps1",
    "version:update": "pwsh -NoProfile -File ./scripts/update-version-MdVisualizer.ps1",
    "version:test": "pwsh -NoProfile -File ./scripts/test-version-update.ps1",
    "test:run-scripts": "pwsh -NoProfile -File ./scripts/test-run-script-naming.ps1",
    "release:test-safety": "pwsh -NoProfile -File ./scripts/test-release-automation.ps1",
    "pretest": "npm run build:embedded && npm run typecheck:incremental && npm run test:web-platform && node ./scripts/test-button-style-rules.mjs && node ./web-platform/scripts/check-ui-styles.mjs && node ./scripts/test-css-style-stats.mjs && npm run check:ui-contract && npm run check:block-commands",
    "test": "vitest run",
    "test:diff-layout": "tsc --project tests/diff-layout/tsconfig.json && node ./scripts/test-diff-layout.mjs",
    "test:button-style-rules": "node ./scripts/test-button-style-rules.mjs",
    "test:button-layout-web": "node ./scripts/test-web-button-layout.mjs",
    "test:css-style-stats": "node ./scripts/test-css-style-stats.mjs",
    "test:print-pdf": "tsc --project tests/print-pdf/tsconfig.json && node ./scripts/test-print-pdf.mjs",
    "test:drawio-editing": "vitest run src/components/DrawioEditingFlow.test.tsx src/components/DrawioEditorModal.test.tsx src/components/DrawioBlock.test.tsx src/components/ExternalDrawioBlock.test.tsx src/components/MarkdownPreview.drawio.test.tsx src/components/StandaloneDocumentPreview.test.tsx src/lib/drawio.test.ts src/lib/drawioStorage.test.ts",
    "report:editing": "node ./scripts/generate-editing-test-report.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:branding": "node ./scripts/test-branding.mjs",
    "setup:web-platform": "node scripts/setup-web-platform.mjs",
    "check:shared": "node scripts/sync-desktop-shared.mjs --check",
    "postinstall": "node scripts/setup-web-platform.mjs",
    "test:web-platform": "node scripts/test-web-platform-setup.mjs && node scripts/sync-desktop-shared.mjs --check",
    "validate:all": "pwsh -NoProfile -File scripts/Invoke-Validate-MdVisualizer-all.ps1",
    "check:ui-contract": "node scripts/ui-command-contract.mjs",
    "test:ui-contract": "node scripts/test-ui-command-contract.mjs && node scripts/test-ui-control-locations.mjs",
    "publish:web": "pwsh -NoProfile -File scripts/publish-web-MdVisualizer-limited.ps1",
    "validate:fast": "node scripts/validate-fast.mjs",
    "validate:quick": "node scripts/validate-fast.mjs --typecheck",
    "test:profile": "node scripts/profile-tests.mjs",
    "check:block-commands": "node scripts/check-block-command-semantics.mjs",
    "test:block-commands": "node scripts/test-block-command-semantics.mjs",
    "test:validation-cache": "node scripts/test-validation-cache.mjs",
    "ui:fixture": "node web-platform/scripts/generate-ui-style-fixture.mjs",
    "typecheck:incremental": "tsc --noEmit --incremental --tsBuildInfoFile .tools/validation-cache/types.tsbuildinfo"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@mdvisualizer/markdown-core": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@zip.js/zip.js": "^2.14.1",
    "codemirror": "^6.0.2",
    "encoding-japanese": "^2.3.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "5.6.205",
    "playwright-core": "1.62.1",
    "postcss": "^8.5.23",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
