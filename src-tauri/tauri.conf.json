{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdVisualizer",
  "version": "0.0.17",
  "identifier": "com.mdvisualizer.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MdVisualizer",
        "width": 1000,
        "height": 750,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "spmd"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "MdVisualizer Markdown",
        "description": "MdVisualizer Markdown document",
        "role": "Editor"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "MdVisualizer SVG",
        "description": "MdVisualizer SVG document",
        "role": "Editor"
      },
      {
        "ext": [
          "drawio"
        ],
        "name": "MdVisualizer draw.io",
        "description": "MdVisualizer draw.io document",
        "role": "Editor"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "MdVisualizer Mermaid",
        "description": "MdVisualizer Mermaid document",
        "role": "Editor"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "MdVisualizer TSV",
        "description": "MdVisualizer TSV document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
