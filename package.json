{
  "name": "markdown-viewer",
  "private": true,
  "version": "0.0.14",
  "author": "KotorinChunChun",
  "repository": "https://github.com/KotorinChunChun/MarkdownViewer",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "run:debug": "pwsh -NoProfile -File ./scripts/run-debug-MarkdownViewer-all.ps1",
    "run:release": "pwsh -NoProfile -File ./scripts/run-release-MarkdownViewer-all.ps1",
    "run:exe": "pwsh -NoProfile -File ./scripts/run-exe-MarkdownViewer-all.ps1",
    "debug:smoke": "pwsh -NoProfile -File ./scripts/run-debug-MarkdownViewer-all-smoke.ps1",
    "build:core": "npm --workspace @markdown-viewer/markdown-core run build",
    "build": "npm run build:core && tsc && vite build",
    "build:spfx": "pwsh -NoProfile -File ./scripts/build-release-MarkdownViewer-spfx.ps1",
    "build:spfx:local": "pwsh -NoProfile -File ./scripts/build-release-MarkdownViewer-spfx.ps1",
    "package:msix": "pwsh -NoProfile -File ./scripts/package-MarkdownViewer-msix.ps1",
    "package:appinstaller": "pwsh -NoProfile -File ./scripts/package-MarkdownViewer-appinstaller.ps1",
    "build:msix": "npm run package:msix",
    "build:appinstaller": "npm run package:appinstaller",
    "release:plan": "pwsh -NoProfile -File ./scripts/publish-release-MarkdownViewer-all.ps1 -Mode Plan",
    "test:run-scripts": "pwsh -NoProfile -File ./scripts/test-run-script-naming.ps1",
    "release:test-safety": "pwsh -NoProfile -File ./scripts/test-release-automation.ps1",
    "test": "vitest run",
    "test:diff-layout": "tsc --project tests/diff-layout/tsconfig.json && node ./scripts/test-diff-layout.mjs",
    "test:print-pdf": "tsc --project tests/print-pdf/tsconfig.json && node ./scripts/test-print-pdf.mjs",
    "test:drawio-editing": "vitest run src/components/DrawioEditingFlow.test.tsx src/components/DrawioEditorModal.test.tsx src/components/DrawioBlock.test.tsx src/components/ExternalDrawioBlock.test.tsx src/components/MarkdownPreview.drawio.test.tsx src/components/StandaloneDocumentPreview.test.tsx src/lib/drawio.test.ts src/lib/drawioStorage.test.ts",
    "report:editing": "node ./scripts/generate-editing-test-report.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@markdown-viewer/markdown-core": "0.0.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "5.6.205",
    "playwright-core": "1.62.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
