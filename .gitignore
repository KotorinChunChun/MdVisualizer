# ============================================================================
# .gitignore (MdVisualizer)
# ============================================================================

/release/
/dev/private/
/dev/temp/
/dev/history/*/logs/
/.pnpm-store/

# ビルド成果物・中間生成物
target/
src-tauri/target/
node_modules/
dist/
build/
.tools/
packages/*/lib/
spfx/lib/
spfx/lib-commonjs/
spfx/jest-output/
spfx/temp/
spfx/sharepoint/
spfx/release/
*.exe
*.dll
*.so
*.pdb

# ローカル環境変数・認証情報
.env
.env.local
secrets.json
*.pfx
*.p12
*.key

# OS・エディタ固有のキャッシュファイル
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user

# ログファイル・実行時一時データ
*.log
*.sqlite
tmp/

# AIキャッシュ
.claude/

# 編集・出力ホストはソースからビルド時に生成
src/generated/*.ts
spfx/src/generated/
web/php/app.html
web/tests/.php-zip-fixtures/

